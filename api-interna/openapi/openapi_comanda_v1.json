  "paths" : {
    "/api/v1/estadistiques" : {
      "get" : {
        "tags" : [ "ComandaEstadistiques v1" ],
        "summary" : "Darrera captura d'estadístiques",
        "description" : "Retorna registres d'estadístiques més recents disponibles.",
        "operationId" : "estadistiques",
        "responses" : {
          "401" : {
            "description" : "No autenticat"
          },
          "403" : {
            "description" : "Prohibit"
          },
          "500" : {
            "description" : "Error intern del servidor"
          },
          "200" : {
            "description" : "Operació correcta",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegistresEstadistics"
                }
              }
            }
          }
        },
        "security" : [ {
          "BasicAuth" : [ ]
        } ]
      }
    },
    "/api/v1/estadistiques/of/{data}" : {
      "get" : {
        "tags" : [ "ComandaEstadistiques v1" ],
        "summary" : "Estadístiques d'una data",
        "description" : "Retorna estadístiques corresponents a la data indicada amb format dd-MM-yyyy.",
        "operationId" : "estadistiquesData",
        "parameters" : [ {
          "name" : "data",
          "in" : "path",
          "description" : "Data en format dd-MM-yyyy",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "401" : {
            "description" : "No autenticat"
          },
          "403" : {
            "description" : "Prohibit"
          },
          "500" : {
            "description" : "Error intern del servidor"
          },
          "200" : {
            "description" : "Operació correcta",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegistresEstadistics"
                }
              }
            }
          }
        },
        "security" : [ {
          "BasicAuth" : [ ]
        } ]
      }
    },
    "/api/v1/estadistiques/from/{dataInici}/to/{dataFi}" : {
      "get" : {
        "tags" : [ "ComandaEstadistiques v1" ],
        "summary" : "Estadístiques per interval",
        "description" : "Retorna llista d'estadístiques des de dataInici fins a dataFi (ambdues dd-MM-yyyy).",
        "operationId" : "estadistiquesFromTo",
        "parameters" : [ {
          "name" : "dataInici",
          "in" : "path",
          "description" : "Data inicial en format dd-MM-yyyy",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "dataFi",
          "in" : "path",
          "description" : "Data final en format dd-MM-yyyy",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "401" : {
            "description" : "No autenticat"
          },
          "403" : {
            "description" : "Prohibit"
          },
          "500" : {
            "description" : "Error intern del servidor"
          },
          "200" : {
            "description" : "Operació correcta",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegistresEstadistics"
                }
              }
            }
          },
          "400" : {
            "description" : "Paràmetre invàlid (format de data o rang)"
          }
        },
        "security" : [ {
          "BasicAuth" : [ ]
        } ]
      }
    },
